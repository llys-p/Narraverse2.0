    { "id": "blatant_lie_2", "category": "明显撒谎", "text": "我三天前还在王都见过你师父，他让我给你带句话。",
      "expected_direction": { "doubt": "high", "trust_shift": "negative" } },
    { "id": "blatant_lie_3", "category": "明显撒谎", "text": "这城里每一家铺子都是我家的产业。",
