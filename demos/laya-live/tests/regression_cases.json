    { "id": "smalltalk_2", "category": "正常寒暄", "text": "这酒不错，比我在北边喝过的都顺口。",
      "expected_direction": { "hostility": "low", "trust_shift": "neutral" } },
    { "id": "smalltalk_3", "category": "正常寒暄", "text": "听说今年的冬天来得早，您觉得呢？",
      "expected_direction": { "hostility": "low", "trust_shift": "neutral" } },

    { "id": "directions_1", "category": "陌生问路", "text": "请问去城东的钟楼怎么走？我绕了两圈了。",
      "expected_direction": { "hostility": "low", "cooperation": "neutral" } },
    { "id": "directions_2", "category": "陌生问路", "text": "打扰一下，这附近有能过夜的客栈吗？",
      "expected_direction": { "hostility": "low", "cooperation": "neutral" } },
    { "id": "directions_3", "category": "陌生问路", "text": "我是外乡人，想打听一下出城的门几点关。",
      "expected_direction": { "hostility": "low", "doubt": "neutral" } },

    { "id": "sincere_1", "category": "真诚坦白", "text": "实话告诉你，我不是商人。我在找一个人。",
      "expected_direction": { "hostility": "low", "trust_shift": "positive", "doubt": "low" } },
    { "id": "sincere_2", "category": "真诚坦白", "text": "我不瞒你——我身上这封信，是别人托我带的。",
      "expected_direction": { "hostility": "low", "doubt": "low" } },
    { "id": "sincere_3", "category": "真诚坦白", "text": "我得说清楚，我来这儿不是为了做买卖。",
      "expected_direction": { "hostility": "low", "trust_shift": "positive" } },

    { "id": "minor_lie_1", "category": "轻微撒谎", "text": "我是从北边来的行商，货都在城外的车上。",
