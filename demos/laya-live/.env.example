# ===========================================================================
# Laya 实时对话桥 —— 配置样例
# ★ 本文件由 _gen_env_example.py 生成，**不要手改**：改文案请改生成器，否则会被覆盖。
# ===========================================================================
#
# 用法：cp .env.example .env，然后在 .env 里填你自己的值。
# .env 已被 .gitignore 忽略，不会入库；本文件只是样板，里面没有任何真实密钥。
#
# ── 键名与优先级（见 laya_bridge.py 的 load_env_file()，以下为准）──────────
#   · 密钥类（DEEPSEEK_API_KEY / LLM_API_KEY）—— **.env 优先**，覆盖系统环境变量。
#     为什么反过来：本机用户级环境变量里存着一个已失效的旧 key（尾号 d4f0）。
#     若让系统优先，.env 里有效的 key 会被静默屏蔽 —— 表现为 401，而报错里只显示
#     d4f0，极难定位。被覆盖的键会在启动横幅与 /health 的 env_overridden 里报出来。
#   · 其它项（LAYA_MODEL / LLM_EFFORT / LLM_MAX_TOKENS ...）—— **系统环境变量优先**，
#     方便临时试参数而不改文件，例如：
#         LAYA_MODEL=english python laya_bridge.py signaltest
#     （Windows cmd 下用 `set X=Y && ...` 的写法。）
#
# ── 下面到文件结尾的内容来自 .env（密钥已脱敏）──────────────────────────

# Narraverse × Laya 本地密钥与 LLM 配置
# 注意：本文件含明文密钥，不要提交进 git（同目录已有 .gitignore 忽略它）
# 优先级规则（见 laya_bridge.py 的 load_env_file）：
#   - 密钥类（DEEPSEEK_API_KEY / LLM_API_KEY）：本文件优先。
#     本机用户级环境变量里存着一个已失效的旧 key（尾号 d4f0），若让系统优先，
#     这里有效的 key 会被静默屏蔽，表现为 401 而报错只显示 d4f0，极难定位。
#     被覆盖的键会在启动横幅和 /health 的 env_overridden 里报出来。
#   - 其它键（LAYA_MODEL / LLM_EFFORT 等）：系统环境变量优先，方便临时试参数：
#         LAYA_MODEL=english python laya_bridge.py langtest

DEEPSEEK_API_KEY=sk-在此填入你自己的密钥
LLM_BASE_URL=https://api.deepseek.com

# 模型 id 是 deepseek-flash（显示名是 DeepSeek-V4.1-Flash，两者不同！传显示名会 400）
# 另一个可选：deepseek-v4-pro（仅文本）
LLM_MODEL=deepseek-flash

# effort 档位：low / high / max，默认 high。
# 实测一句 NPC 台词：low 约 291 输出 token / 285ms，high 约 554 token / 429ms，
# 其中 60~80% 是推理 token（reasoning_tokens）。游戏循环里 low 足够。
LLM_EFFORT=low

# 必须留够：推理 token 也算在里面。400 会把推理吃光导致正文为空字符串。
LLM_MAX_TOKENS=1600

# ---------------------------------------------------------------------------
# Laya 决策引擎
# ---------------------------------------------------------------------------

# 用哪个检查点。三个可选（都是同一个 HF 仓库的子目录）：
#   typed-decisions（默认）421M ModernBERT-large 1024ctx
#       在四个特定合成工作流上微调过：agent_trace_observability /
#       customer_service / invoice_processing / security_incidents。
#       router.py 原文说明它「不该做静默默认」。本项目的叙事决策问题集
#       不属于那四个工作流，所以它是否比 english 更好，必须实测：
#           .venv/Scripts/python.exe laya_bridge.py langtest
#   english  421M ModernBERT-large 512ctx —— 通用校准模型，Router 的默认
#   multilingual 322M mmBERT-base 1024ctx —— 100+ 语言（中文决策文档用这个试过，
#       但 README 基准显示它在 typed-decisions 任务上仅 0.342，低于 0.318 随机基线）
LAYA_MODEL=typed-decisions

# =1（默认）只把 LAYA_MODEL 那一个检查点常驻内存。
# 注意不要改成用 Router(preload=True)——那会把三个检查点全下载并常驻（约 2.3GB）。
LAYA_PRELOAD=1

# cuda / cpu；留空自动判断。本机 torch 是 +cpu 版，会自动落到 cpu。
# LAYA_DEVICE=cpu

# ===========================================================================
# 运行方式备注（同样由生成器维护）
# ===========================================================================
#
# 检查点对照（§11）：typed-decisions 与 english 必须在**两个进程**里各跑一次，
# 两个 800MB 级检查点同时驻留会 OOM（segfault 且无 traceback）：
#     python laya_bridge.py signaltest
#     LAYA_MODEL=english python laya_bridge.py signaltest
#     python laya_bridge.py ckptcompare
#
# GPU：默认 .venv 里 torch 是 +cpu 版，会自动落到 cpu。
# 要跑真 GPU，先 bash _build_cuda_env.sh 建出 .venv-cuda（用 _fetch_cuda_torch.sh
# 下好并校验过的 cu126 轮子），再用它的解释器：
#     LAYA_DEVICE=cuda .venv-cuda/Scripts/python.exe laya_bridge.py bench
# 本机 GPU：RTX 4060 Laptop / 8188 MiB / 驱动 595.71。
#
# 人格渲染写法：signed（extraversion -0.35）或 polarity（introversion 0.35）。
# 环境变量优先于配置，用于 personatest 的写法对照：
#     LAYA_PERSONA_STYLE=polarity python laya_bridge.py personatest
# LAYA_PERSONA_STYLE=signed
